# MediSync Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=medisync
PG_USER=postgres
PG_PASSWORD=your_postgres_password
# Set to 'true' in production (requires valid SSL cert on the server)
PG_SSL=false
# Maximum pool connections (default 10)
PG_POOL_MAX=10

# ─── Firebase Admin SDK ────────────────────────────────────────────────────────
# Path to your Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
# OR paste the JSON inline as a base64 string:
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64_encoded_json>

# ─── JWT (used for optional stateless sessions) ────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Firebase Cloud Messaging ──────────────────────────────────────────────────
# FCM is handled via Firebase Admin SDK — no separate key needed

# ─── ESP32 WebSocket ──────────────────────────────────────────────────────────
# The ESP32 connects to this server via Socket.IO
ESP32_AUTH_TOKEN=esp32_secret_device_token_change_in_production

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
